                "deleted_files") echo "  - $1 deleted files" ;;
                "commit_prompt") echo "Use this commit message?" ;;
                "commit_success") echo "✅ Commit created successfully!" ;;
                "commit_message") echo "📝 Commit message:" ;;
                "commit_info") echo "📋 Commit info:" ;;
