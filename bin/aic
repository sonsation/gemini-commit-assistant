                "help_configure_cmd") echo "  aic --configure         # 언어 설정 변경" ;;
                "unknown_option") echo "❌ 알 수 없는 옵션:" ;;
                "usage_help") echo "사용법: aic [--all|-a] [--provider <agy|claude>] [--configure] [--setup|--unsetup] [--help|-h]" ;;
