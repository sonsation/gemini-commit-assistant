                "staging_all") echo "📦 모든 파일을 staging합니다..." ;;
                "agy_not_installed") echo "⚠️  agy CLI가 설치되어 있지 않습니다. 먼저 Antigravity CLI를 설치해주세요." ;;
                "provider_not_installed") echo "⚠️  '$1' CLI가 설치되어 있지 않습니다. 먼저 설치하거나 'aic --configure'로 다른 AI를 선택해주세요." ;;
                "provider_failed") echo "⚠️  '$1' CLI 실행에 실패했습니다." ;;
                "fallback_editor") echo "🔧 일반 에디터로 커밋 메시지를 작성합니다..." ;;
                "editor_prompt") echo "텍스트 에디터에서 커밋 메시지를 남기시겠습니까?" ;;
                "action_yes") echo "네 (Yes)" ;;
                "action_no") echo "취소 (Cancel)" ;;
                "action_regenerate") echo "다시 생성 (Regenerate)" ;;
                "action_edit") echo "메시지 수정 (Edit)" ;;
                "action_custom") echo "직접 입력 (Custom)" ;;
                "regenerating_message") echo "🔄 커밋 메시지를 다시 생성합니다..." ;;
                "detected_issue") echo "💡 브랜치에서 이슈 키 감지됨: $1" ;;
                "editor_cancelled") echo "🚫 취소되었습니다." ;;
                "editor_invalid") echo "y 또는 n을 입력해주세요." ;;
                "no_staged_files") echo "⚠️  staging된 파일이 없습니다." ;;
                "choose_action") echo "💡 다음 중 하나를 선택하세요:" ;;
                "action_1") echo "  1. ${BOLD}git add <파일명>${NC} 으로 특정 파일을 staging" ;;
                "action_2") echo "  2. ${BOLD}git add .${NC} 으로 모든 파일을 staging" ;;
                "action_3") echo "  3. ${BOLD}aic --all${NC} 으로 모든 파일을 자동 staging" ;;
                "unstaged_files") echo "📊 unstaged 파일 목록:" ;;
                "no_changes") echo "📊 변경된 파일이 없습니다." ;;
                "analyzing_staged") echo "📝 Staged 파일의 변경사항을 분석합니다..." ;;
                "ai_generating") 
                    local m="${1:-기본 모델}"
                    echo "🤖 AI ($m)가 커밋 메시지를 생성 중입니다..." 
                    ;;
                "ai_generated") echo "🎯 AI 생성 커밋 메시지:" ;;
                "ai_no_response") echo "⚠️  AI 응답을 받지 못했습니다." ;;
                "change_summary") echo "📊 변경사항 요약:" ;;
                "new_files") echo "  + $1 새 파일" ;;
                "modified_files") echo "  ~ $1 수정된 파일" ;;
                "deleted_files") echo "  - $1 삭제된 파일" ;;
                "commit_prompt") echo "이 커밋 메시지를 사용하시겠습니까?" ;;
                "commit_success") echo "✅ 커밋이 성공적으로 생성되었습니다!" ;;
                "commit_message") echo "📝 커밋 메시지:" ;;
                "commit_info") echo "📋 커밋 정보:" ;;
                "commit_failed") echo "❌ 커밋 생성에 실패했습니다." ;;
                "commit_cancelled") echo "🚫 커밋이 취소되었습니다." ;;
                "editor_starting") echo "✏️  에디터를 시작합니다..." ;;
                "edit_success") echo "✅ 편집된 커밋이 성공적으로 생성되었습니다!" ;;
                "edit_cancelled") echo "🚫 편집이 취소되었습니다." ;;
                "custom_message") echo "✏️  커스텀 커밋 메시지를 입력하세요:" ;;
                "custom_success") echo "✅ 커스텀 커밋이 성공적으로 생성되었습니다!" ;;
                "empty_message") echo "⚠️  커밋 메시지가 비어있습니다." ;;
                "invalid_choice") echo "❌ y, n, e, 또는 c를 입력해주세요." ;;
                "configure_title") echo "🌐 언어 설정" ;;
                "configure_current") echo "📍 현재 언어: $1" ;;
                "configure_select") echo "🔤 언어를 선택하세요 / Select language:" ;;
                "configure_korean") echo "한국어 (Korean)" ;;
                "configure_english") echo "English" ;;
                "configure_prompt") echo "선택하세요: " ;;
                "configure_success") echo "✅ 언어가 설정되었습니다: $1" ;;
                "configure_invalid") echo "❌ 잘못된 선택입니다." ;;
                "first_run_title") echo "🎉 AI Commit Assistant에 오신 것을 환영합니다!" ;;
                "first_run_subtitle") echo "최초 설정" ;;
                "first_run_desc") echo "UI와 커밋 메시지에 사용할 언어를 선택해주세요:" ;;
                "config_local_title") echo "로컬(프로젝트) 설정 (.aicrc)" ;;
                "config_global_title") echo "글로벌 설정 (~/.gemini-commit-config.json)" ;;
                "config_current_settings") echo "📍 현재 설정:" ;;
                "config_current_lang") echo "  - 언어 (Language): ${1:-기본값(ko)}" ;;
                "config_current_model") echo "  - 모델 (Model): ${1:-지정 안 됨}" ;;
                "config_current_provider") echo "  - AI CLI (Provider): ${1:-agy (기본값)}" ;;
                "config_provider_title") echo "사용할 AI CLI 설정 (Provider)" ;;
                "config_provider_prompt") echo "선택: " ;;
                "config_provider_agy") echo "agy (Antigravity / Gemini)" ;;
                "config_provider_claude") echo "claude (Claude Code)" ;;
                "config_provider_missing") echo "  ⚠️ '$1' 이(가) 이 컴퓨터에 설치되어 있지 않습니다." ;;
                "config_lang_title") echo "언어 설정 (Language)" ;;
                "config_skip") echo "변경 안 함 (Skip)" ;;
                "config_prompt_lang") echo "선택: " ;;
                "config_model_title") echo "AI 모델 설정 (Model)" ;;
                "config_model_fetching") echo "  사용 가능한 모델을 불러오는 중..." ;;
                "config_model_fetch_failed") echo "  ⚠️ 모델 목록을 불러오지 못했습니다." ;;
                "config_model_hint_manual") echo "  (엔터를 치면 기존 설정을 유지하고, 'clear'를 입력하면 설정을 지웁니다)" ;;
                "config_model_prompt_manual") echo "모델 이름 직접 입력: " ;;
                "config_model_skip") echo "변경 안 함 (Skip)" ;;
                "config_model_clear") echo "설정 지우기 (Clear)" ;;
                "config_model_prompt_list") echo "선택: " ;;
                "config_saved") echo "✅ 설정이 저장되었습니다! ($1)" ;;
                "config_which") echo "어느 설정을 변경하시겠습니까?" ;;
                "config_choice_global") echo "글로벌 설정 (모든 프로젝트에 공통 적용)" ;;
                "config_choice_local") echo "로컬 설정 (현재 프로젝트에만 적용)" ;;
                "config_prompt_which") echo "선택: " ;;
                *) echo "$key" ;;
            esac
            ;;
    esac
}

# 설정 변경 함수
configure_settings() {
    local scope=$1
    if [ "$scope" = "local" ]; then
        echo -e "${BLUE}============================================================${NC}"
        echo -e "${BOLD}$(msg "config_local_title")${NC}"
        echo -e "${BLUE}============================================================${NC}"
        TARGET_FILE="$LOCAL_CONFIG_FILE"
        CURRENT_LANG="$LOCAL_LANG"
        CURRENT_MODEL="$LOCAL_MODEL"
        CURRENT_PROVIDER="$LOCAL_PROVIDER"
    else
        echo -e "${BLUE}============================================================${NC}"
        echo -e "${BOLD}$(msg "config_global_title")${NC}"
        echo -e "${BLUE}============================================================${NC}"
        TARGET_FILE="$CONFIG_FILE"
        CURRENT_LANG="$LANGUAGE"
        CURRENT_MODEL="$MODEL"
        CURRENT_PROVIDER="$PROVIDER"
    fi
    echo ""

    echo -e "${CYAN}$(msg "config_current_settings")${NC}"
    echo -e "$(msg "config_current_lang" "$CURRENT_LANG")"
    echo -e "$(msg "config_current_provider" "$CURRENT_PROVIDER")"
    echo -e "$(msg "config_current_model" "$CURRENT_MODEL")"
    echo ""

    echo -e "${CYAN}$(msg "config_lang_title")${NC}"
    local lang_opts=("$(msg "configure_korean")" "$(msg "configure_english")" "$(msg "config_skip")")
    interactive_menu "$(msg "config_prompt_lang")" lang_opts 0
    case $MENU_RESULT in
        0) TEMP_LANG="ko" ;;
        1) TEMP_LANG="en" ;;
        2) TEMP_LANG="${CURRENT_LANG:-ko}" ;;
    esac

    # AI CLI(provider) 선택
    echo ""
    echo -e "${CYAN}$(msg "config_provider_title")${NC}"
    local provider_opts=("$(msg "config_provider_agy")" "$(msg "config_provider_claude")" "$(msg "config_skip")")
    local provider_default=0
    [ "${CURRENT_PROVIDER:-agy}" = "claude" ] && provider_default=1
    interactive_menu "$(msg "config_provider_prompt")" provider_opts $provider_default
    case $MENU_RESULT in
        0) TEMP_PROVIDER="agy" ;;
        1) TEMP_PROVIDER="claude" ;;
        # 로컬 설정에서 Skip이면 값을 비워 둬서 글로벌 설정이 그대로 적용되게 함
        2) TEMP_PROVIDER="$CURRENT_PROVIDER" ;;
    esac

    # 실제로 적용될 provider (로컬에서 미지정이면 상속된 값)
    local effective_provider="${TEMP_PROVIDER:-$PROVIDER}"

    if ! command -v "$effective_provider" >/dev/null 2>&1; then
        echo -e "${YELLOW}$(msg "config_provider_missing" "$effective_provider")${NC}"
    fi

    # provider가 바뀌면 기존 모델 ID는 호환되지 않으므로 초기화
    if [ "$TEMP_PROVIDER" != "$CURRENT_PROVIDER" ]; then
        CURRENT_MODEL=""
    fi

    echo ""
    echo -e "${CYAN}$(msg "config_model_title")${NC}"
    echo -e "$(msg "config_model_fetching")"

    # 모델 목록은 새로 선택한 provider 기준으로 조회
    local saved_provider="$PROVIDER"
    PROVIDER="$effective_provider"
    fetch_models
    PROVIDER="$saved_provider"

    if [ ${#models[@]} -eq 0 ]; then
        echo -e "${YELLOW}$(msg "config_model_fetch_failed")${NC}"
        echo -e "$(msg "config_model_hint_manual")"
        read -p "$(msg "config_model_prompt_manual")" model_input
        
        if [ "$model_input" = "clear" ]; then
            TEMP_MODEL=""
        elif [ -n "$model_input" ]; then
            TEMP_MODEL="$model_input"
        else
            TEMP_MODEL="$CURRENT_MODEL"
        fi
    else
        local model_opts=("$(msg "config_model_skip")" "$(msg "config_model_clear")")
        for i in "${!models[@]}"; do
            model_opts+=("${model_displays[$i]}")
        done
        
        interactive_menu "$(msg "config_model_prompt_list")" model_opts 0
        
        if [ "$MENU_RESULT" = "0" ]; then
            TEMP_MODEL="$CURRENT_MODEL"
        elif [ "$MENU_RESULT" = "1" ]; then
            TEMP_MODEL=""
        else
            TEMP_MODEL="${models[$((MENU_RESULT-2))]}"
        fi
    fi
    
    # 설정 저장
    mkdir -p "$(dirname "$TARGET_FILE")"
    write_config_file "$TARGET_FILE" "$TEMP_LANG" "$TEMP_MODEL" "$TEMP_PROVIDER"

    echo ""
    echo -e "${GREEN}$(msg "config_saved" "$TARGET_FILE")${NC}"
    
    # 설정 다시 로드
    load_config
}

# 최초 실행 체크 및 언어 설정
first_time_setup() {
    # 항상 영어로 시작 (다국어 지원을 위해)
    echo -e "${MAGENTA}🎉 Welcome to AI Commit Assistant!${NC}"
    echo -e "${BLUE}============================================================${NC}"
    echo -e "${BOLD}First-time setup${NC}"
    echo -e "${BLUE}============================================================${NC}"
    echo ""
    echo -e "${CYAN}Please select your preferred language for UI and commit messages:${NC}"
    echo ""
    
    local setup_opts=("한국어 (Korean)" "English")
    interactive_menu "Please select your preferred language for UI and commit messages:" setup_opts 0
    case $MENU_RESULT in
        0) LANGUAGE="ko" ;;
        1) LANGUAGE="en" ;;
    esac

    # 사용할 AI CLI 선택 (설치되어 있는 쪽을 기본값으로)
    echo ""
    local provider_opts=("agy (Antigravity / Gemini)" "claude (Claude Code)")
    local provider_default=0
    if ! command -v agy >/dev/null 2>&1 && command -v claude >/dev/null 2>&1; then
        provider_default=1
    fi
    interactive_menu "Which AI CLI should generate your commit messages? / 어떤 AI CLI를 사용할까요?" provider_opts $provider_default
    case $MENU_RESULT in
        0) PROVIDER="agy" ;;
        1) PROVIDER="claude" ;;
    esac

    save_config "$LANGUAGE"

    if [ "$LANGUAGE" = "ko" ]; then
        echo -e "${GREEN}✅ 언어가 설정되었습니다: 한국어 / AI CLI: $PROVIDER${NC}"
    else
        echo -e "${GREEN}✅ Language set to: English / AI CLI: $PROVIDER${NC}"
    fi
}

# --provider 플래그를 먼저 훑어서 설정 로드보다 우선 적용
PROVIDER_OVERRIDE=""
for ((i=1; i<=$#; i++)); do
    case "${!i}" in
        --agy) PROVIDER_OVERRIDE="agy" ;;
        --claude) PROVIDER_OVERRIDE="claude" ;;
        --provider)
            j=$((i+1))
            PROVIDER_OVERRIDE="${!j}"
            ;;
        --provider=*) PROVIDER_OVERRIDE="${!i#--provider=}" ;;
    esac
done

if [ -n "$PROVIDER_OVERRIDE" ] && [ "$PROVIDER_OVERRIDE" != "agy" ] && [ "$PROVIDER_OVERRIDE" != "claude" ]; then
    echo -e "${RED}❌ Unknown provider: $PROVIDER_OVERRIDE (use 'agy' or 'claude')${NC}"
    exit 1
fi

# 설정 로드
load_config

# 플래그 변수 초기화
STAGE_ALL=false

# 인자 처리
while [[ $# -gt 0 ]]; do
    case $1 in
        --setup)
            # 설정이 없으면 먼저 언어 설정
            if [ -z "$LANGUAGE" ]; then
                first_time_setup
            fi
            
            echo -e "${CYAN}$(msg "setup_progress")${NC}"
            
            # git aic alias 설정
            git config --global alias.aic '!aic'
            
            if [ $? -eq 0 ]; then
                echo -e "${GREEN}$(msg "setup_success")${NC}"
                echo -e "${CYAN}$(msg "setup_available")${NC}"
                echo "  - aic"
                echo "  - ai-commit"
                echo "  - git aic"
            else
                echo -e "${RED}$(msg "setup_failed")${NC}"
                exit 1
            fi
            exit 0
            ;;
        --unsetup)
            # 설정이 없으면 먼저 언어 설정
            if [ -z "$LANGUAGE" ]; then
                first_time_setup
            fi
            
            echo -e "${CYAN}$(msg "unsetup_progress")${NC}"
            
            # git aic alias 해제
            git config --global --unset alias.aic
            
            if [ $? -eq 0 ]; then
                echo -e "${GREEN}$(msg "unsetup_success")${NC}"
                echo -e "${CYAN}$(msg "unsetup_available")${NC}"
                echo "  - aic"
                echo "  - ai-commit"
                echo ""
                echo -e "${CYAN}$(msg "unsetup_help")${NC}"
                echo "  aic --setup"
            else
                echo -e "${RED}$(msg "unsetup_failed")${NC}"
                echo -e "${CYAN}$(msg "unsetup_not_found")${NC}"
                exit 1
            fi
            exit 0
            ;;
        --config-global)
            if [ -z "$LANGUAGE" ]; then first_time_setup; fi
            configure_settings "global"
            exit 0
            ;;
        --config-local)
            if [ -z "$LANGUAGE" ]; then first_time_setup; fi
            configure_settings "local"
            exit 0
            ;;
        --configure)
            if [ -z "$LANGUAGE" ]; then first_time_setup; fi
            conf_opts=("$(msg "config_choice_global")" "$(msg "config_choice_local")")
            interactive_menu "$(msg "config_which")" conf_opts 0
            case $MENU_RESULT in
                0) configure_settings "global" ;;
                1) configure_settings "local" ;;
            esac
            exit 0
            ;;
        --all|-a)
            STAGE_ALL=true
            shift
            ;;
        --provider)
            # 값은 이미 위에서 읽었으므로 여기서는 소비만 함
            shift 2
            ;;
        --provider=*|--agy|--claude)
            shift
            ;;
        --help|-h)
            # 설정이 없으면 먼저 언어 설정
            if [ -z "$LANGUAGE" ]; then
                first_time_setup
            fi
            
            echo -e "${BOLD}$(msg "welcome")${NC}"
            echo ""
            echo -e "${CYAN}$(msg "help_usage")${NC}"
            echo -e "$(msg "help_staged")"
            echo -e "$(msg "help_all")"
            echo -e "$(msg "help_short_cmd")"
            echo -e "$(msg "help_git_alias")"
            echo ""
            echo -e "${CYAN}$(msg "help_options")${NC}"
            echo -e "$(msg "help_all_desc")"
            echo -e "$(msg "help_configure_desc")"
            echo -e "$(msg "help_provider_desc")"
            echo "  --config-global         # 글로벌(전역) 설정 변경"
            echo "  --config-local          # 로컬(프로젝트) 설정 변경"
            echo -e "$(msg "help_setup_desc")"
            echo -e "$(msg "help_unsetup_desc")"
            echo -e "$(msg "help_help_desc")"
            echo ""
            echo -e "${CYAN}$(msg "help_settings")${NC}"
            echo -e "$(msg "help_setup_cmd")"
            echo -e "$(msg "help_unsetup_cmd")"
            echo -e "$(msg "help_configure_cmd")"
            echo ""
            echo -e "${CYAN}$(msg "help_example")${NC}"
            echo "  git add file1.js file2.js"
            echo -e "$(msg "help_example_staged")"
            echo ""
            echo -e "$(msg "help_example_all")"
            echo ""
            exit 0
            ;;
        *)
            echo -e "${RED}$(msg "unknown_option") $1${NC}"
            echo -e "$(msg "usage_help")"
            exit 1
            ;;
    esac
done

# 최초 실행 체크
if [ -z "$LANGUAGE" ]; then
    first_time_setup
fi

# 브라일 로딩 애니메이션 함수
show_braille() {
    local pid=$1
    local delay=0.08
    local braille="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    local i=0
    
    local label="$PROVIDER"
    [ -n "$MODEL" ] && label="$PROVIDER / $MODEL"
    local generating_msg=$(msg "ai_generating" "$label")
    
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r${CYAN}${generating_msg} ${braille:$i:1}${NC}"
        i=$(((i+1) % ${#braille}))
        sleep $delay
    done
    printf "\r${CYAN}${generating_msg} ✓${NC}\n"
}

echo -e "${MAGENTA}$(msg "welcome")${NC}"

# Git 저장소 확인
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "${RED}$(msg "not_git_repo")${NC}"
    exit 1
fi

# --all 플래그가 있으면 모든 파일을 staging
if [ "$STAGE_ALL" = true ]; then
    echo -e "${CYAN}$(msg "staging_all")${NC}"
    git add .
fi

# 선택된 AI CLI 설치 확인
if ! command -v "$PROVIDER" >/dev/null 2>&1; then
    echo -e "${YELLOW}$(msg "provider_not_installed" "$PROVIDER")${NC}"
    echo ""

    editor_opts=("$(msg "action_yes")" "$(msg "action_no")")
    interactive_menu "$(msg "editor_prompt")" editor_opts 0
    if [ "$MENU_RESULT" = "0" ]; then
        echo -e "${CYAN}$(msg "fallback_editor")${NC}"
        echo ""
        git commit
        exit $?
    else
        echo -e "${CYAN}$(msg "editor_cancelled")${NC}"
        exit 0
    fi
fi

# 변경사항 확인
STAGED_DIFF=$(git diff --cached 2>/dev/null)
UNSTAGED_DIFF=$(git diff 2>/dev/null)
STATUS=$(git status --porcelain 2>/dev/null)
STAGED_STATUS=$(git diff --cached --name-status 2>/dev/null)
STAGED_STAT=$(git diff --cached --stat 2>/dev/null)

# staged 파일이 있는지 확인
if [ -z "$STAGED_DIFF" ]; then
    echo -e "${YELLOW}$(msg "no_staged_files")${NC}"
    echo ""
    echo -e "${CYAN}$(msg "choose_action")${NC}"
    echo -e "$(msg "action_1")"
    echo -e "$(msg "action_2")"
    echo -e "$(msg "action_3")"
    echo ""
    
    if [ -n "$UNSTAGED_DIFF" ]; then
        echo -e "${CYAN}$(msg "unstaged_files")${NC}"
        git status --short | head -10
        if [ $(git status --short | wc -l) -gt 10 ]; then
            echo -e "${YELLOW}... 그리고 $(expr $(git status --short | wc -l) - 10)개 파일 더${NC}"
        fi
    else
        echo -e "${CYAN}$(msg "no_changes")${NC}"
    fi
    exit 1
fi

DIFF="$STAGED_DIFF"
echo -e "${CYAN}$(msg "analyzing_staged")${NC}"

# 브랜치 이슈 키 감지
ISSUE_KEY=$(detect_issue_key)
if [ -n "$ISSUE_KEY" ]; then
    echo -e "${CYAN}$(msg "detected_issue" "$ISSUE_KEY")${NC}"
fi

# 변경사항 분석
ANALYSIS_TEXT="$DIFF"

while true; do
    # 언어별 Gemini 프롬프트 생성
    if [ "$LANGUAGE" = "en" ]; then
        ISSUE_HINT=""
        if [ -n "$ISSUE_KEY" ]; then
            ISSUE_HINT="
BRANCH ISSUE/TICKET DETECTED:
- The current git branch is associated with ticket: $ISSUE_KEY
- Include this ticket key in the title (e.g. feat($ISSUE_KEY): ... or [$ISSUE_KEY] feat: ...)
"
        fi
        DETAILED_MULTILINE_PROMPT="You are a git commit message generator. Analyze these git changes and generate a detailed multiline commit message.

ANALYZE THE CHANGES CAREFULLY:
- Look at file extensions and diff content to understand what changed
- Identify if changes are: code improvements, style/formatting, documentation, features, or cleanup
- Pay attention to deleted files, formatting changes, whitespace fixes
$ISSUE_HINT
GENERATE MESSAGE IN THIS FORMAT:

TITLE (50 chars max):
- Start with: feat: (new features), fix: (bug fixes), refactor: (code improvement), style: (formatting), docs: (documentation), test: (tests), perf: (performance), chore: (cleanup/maintenance)
- Brief summary in English

BODY (after TWO blank lines):
- filename: specific description of changes
- IMPORTANT: TWO blank lines between each file
- Use English language

Git Diff Stat:
$STAGED_STAT

Git Status (Staged only):
$STAGED_STATUS

Changes Analysis:
$(echo "$ANALYSIS_TEXT" | head -2000)

EXACT FORMAT REQUIRED (copy this structure):

feat: Implement user authentication system and loading components


src/utils/auth.ts: JWT token validation and user permission management


src/components/LoadingSpinner.vue: Improved user experience during async operations

CRITICAL: Use exactly TWO newlines between title and body, and TWO newlines between each file.
Keep descriptions under 80 characters.
Generate ONLY the commit message, no quotes:"
    else
        ISSUE_HINT=""
        if [ -n "$ISSUE_KEY" ]; then
            ISSUE_HINT="
브랜치 이슈/티켓 번호 감지됨:
- 현재 git 브랜치는 티켓 $ISSUE_KEY 와 연관되어 있습니다.
- 커밋 제목에 이 티켓 번호를 포함하세요 (예: feat($ISSUE_KEY): ... 또는 [$ISSUE_KEY] feat: ...)
"
        fi
        DETAILED_MULTILINE_PROMPT="You are a git commit message generator. Analyze these git changes and generate a detailed multiline commit message.

ANALYZE THE CHANGES CAREFULLY:
- Look at file extensions and diff content to understand what changed
- Identify if changes are: code improvements, style/formatting, documentation, features, or cleanup
- Pay attention to deleted files, formatting changes, whitespace fixes
$ISSUE_HINT
GENERATE MESSAGE IN THIS FORMAT:

TITLE (50 chars max):
- Start with: feat: (새 기능), fix: (버그 수정), refactor: (코드 리팩토링), style: (포맷팅), docs: (문서), test: (테스트), perf: (성능 개선), chore: (기타/유지보수)
- Brief summary in Korean

BODY (after TWO blank lines):
- filename: specific description of changes
- IMPORTANT: TWO blank lines between each file
- Use Korean language

Git Diff Stat:
$STAGED_STAT

Git Status (Staged only):
$STAGED_STATUS

Changes Analysis:
$(echo "$ANALYSIS_TEXT" | head -2000)

EXACT FORMAT REQUIRED (copy this structure):

feat: 사용자 인증 시스템 구현 및 로딩 컴포넌트 추가


src/utils/auth.ts: JWT 토큰 검증 및 사용자 권한 관리 기능 구현


src/components/LoadingSpinner.vue: 비동기 작업 중 사용자 경험 개선

CRITICAL: Use exactly TWO newlines between title and body, and TWO newlines between each file.
Keep descriptions under 80 characters.
Generate ONLY the commit message, no quotes:"
    fi

    # AI CLI 호출 시도
    AI_MESSAGE=""

    if [ -z "$AI_MESSAGE" ]; then
        # provider별 인자 구성
        build_ai_args "$DETAILED_MULTILINE_PROMPT"

        # 백그라운드에서 AI CLI 실행
        TEMP_OUTPUT="/tmp/aic_output_$$"
        ("$PROVIDER" "${AI_ARGS[@]}" 2>&1 > "$TEMP_OUTPUT"; echo $? > "/tmp/aic_exit_$$") &
        AGY_PID=$!

        # 브라일 애니메이션 시작
        show_braille $AGY_PID

        # 프로세스 완료 대기
        wait $AGY_PID

        # 결과 읽기
        AGY_OUTPUT=$(cat "$TEMP_OUTPUT")
        AGY_EXIT_CODE=$(cat "/tmp/aic_exit_$$")

        # 임시 파일 정리
        rm -f "$TEMP_OUTPUT" "/tmp/aic_exit_$$"

        # AI CLI 실행 실패 시 처리
        if [ $AGY_EXIT_CODE -ne 0 ]; then
            echo -e "${YELLOW}$(msg "provider_failed" "$PROVIDER")${NC}"
            echo ""

            editor_opts=("$(msg "action_yes")" "$(msg "action_no")")
            interactive_menu "$(msg "editor_prompt")" editor_opts 0
            if [ "$MENU_RESULT" = "0" ]; then
                echo -e "${CYAN}$(msg "fallback_editor")${NC}"
                echo ""
                git commit
                exit $?
            else
                echo -e "${CYAN}$(msg "editor_cancelled")${NC}"
                exit 0
            fi
        else
            # 불필요한 출력 제거하고 의미있는 출력 추출
            AI_MESSAGE=$(echo "$AGY_OUTPUT" | grep -v "Loaded cached credentials" | grep -v "^$" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            
            # 길이 체크 (최소 30자 이상이어야 함)
            MSG_LENGTH=${#AI_MESSAGE}
            if [ "$MSG_LENGTH" -lt 30 ]; then
                echo -e "${YELLOW}⚠️  Message too short: $MSG_LENGTH chars. Trying simplified approach...${NC}"
                
                # 언어별 단순 프롬프트
                if [ "$LANGUAGE" = "en" ]; then
                    SIMPLE_PROMPT="Generate a detailed English commit message with title and body for: $(echo "$STAGED_STATUS" | head -10 | tr '\n' ' ')"
                else
                    SIMPLE_PROMPT="Generate a detailed Korean commit message with title and body for: $(echo "$STAGED_STATUS" | head -10 | tr '\n' ' ')"
                fi
                
                # 단순 접근법도 애니메이션과 함께
                TEMP_OUTPUT2="/tmp/aic_simple_$$"

                build_ai_args "$SIMPLE_PROMPT"

                ("$PROVIDER" "${AI_ARGS[@]}" 2>&1 > "$TEMP_OUTPUT2"; echo $? > "/tmp/aic_simple_exit_$$") &
                SIMPLE_PID=$!

                # 브라일 애니메이션으로 재시도
                show_braille $SIMPLE_PID
                wait $SIMPLE_PID

                SIMPLE_OUTPUT=$(cat "$TEMP_OUTPUT2")
                SIMPLE_EXIT_CODE=$(cat "/tmp/aic_simple_exit_$$")
                rm -f "$TEMP_OUTPUT2" "/tmp/aic_simple_exit_$$"
                
                if [ $SIMPLE_EXIT_CODE -eq 0 ]; then
                    AI_MESSAGE=$(echo "$SIMPLE_OUTPUT" | grep -v "Loaded cached credentials" | grep -v "^$" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                else
                    echo -e "${YELLOW}⚠️  Simplified approach also failed. Using editor...${NC}"
                    
                    # 일반 git commit처럼 동작
                    git commit
                    exit $?
                fi
            fi
        fi
    fi

    # AI 응답 처리
    if [ -n "$AI_MESSAGE" ] && [ "$AI_MESSAGE" != "Loaded cached credentials." ]; then
        # 불필요한 텍스트 제거
        AI_MESSAGE=$(echo "$AI_MESSAGE" | sed 's/^["'\'']\|["'\'']$//g' | sed 's/^\*\s*//' | sed 's/^-\s*//')
        
        # 메시지 형식 후처리 - 원하는 형식으로 변환
        AI_MESSAGE=$(echo "$AI_MESSAGE" | awk '
        BEGIN { 
            title_done = 0; 
            body_started = 0;
            first_file = 1;
            file_pattern = "^([a-zA-Z0-9_./-]+(\\.[a-zA-Z0-9_-]+|/)|Dockerfile|Makefile|LICENSE|README|CHANGELOG):[[:space:]]*";
        }
        /^[a-zA-Z]+(\([^)]+\))?:/ { 
            if (!title_done) {
                print $0;
                print "";
                print "";
                title_done = 1;
                next;
            }
        }
        {
            if (title_done && $0 != "") {
                is_file = match($0, file_pattern);
                if (is_file) {
                    if (body_started && !first_file) {
                        print "";
                        print "";
                    }
                    body_started = 1;
                    first_file = 0;
                } else if (!body_started) {
                    print "";
                    print "";
                    body_started = 1;
                }
                print $0;
            }
        }')
        
        echo ""
        echo -e "${BLUE}============================================================${NC}"
        echo -e "${GREEN}$(msg "ai_generated")${NC}"
        echo -e "${BOLD}\"$AI_MESSAGE\"${NC}"
        echo -e "${BLUE}============================================================${NC}"
    else
        echo -e "${YELLOW}$(msg "ai_no_response")${NC}"
        echo -e "${CYAN}$(msg "fallback_editor")${NC}"
        echo ""
        
        # 일반 git commit처럼 동작
        git commit
        exit $?
    fi

    # 변경사항 요약 출력
    echo ""
    echo -e "${CYAN}$(msg "change_summary")${NC}"
    ADDED_FILES=$(echo "$STATUS" | grep "^??\|^A" | wc -l)
    MODIFIED_FILES=$(echo "$STATUS" | grep "^.M\|^M" | wc -l)
    DELETED_FILES=$(echo "$STATUS" | grep "^.D\|^D" | wc -l)

    [ "$ADDED_FILES" -gt 0 ] && echo -e "  ${GREEN}$(msg "new_files" "$ADDED_FILES")${NC}"
    [ "$MODIFIED_FILES" -gt 0 ] && echo -e "  ${YELLOW}$(msg "modified_files" "$MODIFIED_FILES")${NC}"
    [ "$DELETED_FILES" -gt 0 ] && echo -e "  ${RED}$(msg "deleted_files" "$DELETED_FILES")${NC}"
    echo ""

    commit_opts=("$(msg "action_yes")" "$(msg "action_regenerate")" "$(msg "action_edit")" "$(msg "action_custom")" "$(msg "action_no")")
    interactive_menu "$(msg "commit_prompt")" commit_opts 0

    case $MENU_RESULT in
        0)
            if git commit -m "$AI_MESSAGE"; then
                echo -e "${GREEN}$(msg "commit_success")${NC}"
            else
                echo -e "${RED}$(msg "commit_failed")${NC}"
            fi
            break
            ;;
        1)
            echo ""
            echo -e "${CYAN}$(msg "regenerating_message")${NC}"
            echo ""
            continue
            ;;
        2)
            TEMP_FILE="/tmp/aic_edit_commit_$$.txt"
            echo "$AI_MESSAGE" > "$TEMP_FILE"
            echo -e "${CYAN}$(msg "editor_starting")${NC}"
            ${EDITOR:-vi} "$TEMP_FILE"
            
            if [ -s "$TEMP_FILE" ] && grep -q '[^[:space:]]' "$TEMP_FILE"; then
                if git commit -F "$TEMP_FILE"; then
                    echo -e "${GREEN}$(msg "edit_success")${NC}"
                else
                    echo -e "${RED}$(msg "commit_failed")${NC}"
                fi
            else
                echo -e "${YELLOW}$(msg "edit_cancelled")${NC}"
            fi
            rm -f "$TEMP_FILE"
            break
            ;;
        3)
            read -p "$(echo -e "${CYAN}$(msg "custom_message")${NC} ")" CUSTOM_MESSAGE
            if [ -n "$CUSTOM_MESSAGE" ]; then
                if git commit -m "$CUSTOM_MESSAGE"; then
                    echo -e "${GREEN}$(msg "custom_success")${NC}"
                else
                    echo -e "${RED}$(msg "commit_failed")${NC}"
                fi
            else
                echo -e "${YELLOW}$(msg "empty_message")${NC}"
                echo -e "${RED}$(msg "commit_failed")${NC}"
            fi
            break
            ;;
        4)
            echo -e "${YELLOW}$(msg "commit_cancelled")${NC}"
            exit 0
            ;;
    esac
done
