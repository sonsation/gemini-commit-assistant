#!/bin/bash

# Gemini API를 사용한 AI 커밋 메시지 생성기 (최종 버전)

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# 종료 및 시그널 처리: 터미널 커서 복원 및 임시 파일 정리
cleanup() {
    tput cnorm 2>/dev/null
    rm -f /tmp/aic_*_$$ 2>/dev/null
}
trap cleanup EXIT INT TERM

# 대화형 선택 메뉴 함수 (방향키 및 번호 입력 지원)
# 사용법: interactive_menu "프롬프트 텍스트" 선택지배열이름 [기본값인덱스]
interactive_menu() {
    local prompt="$1"
    local array_name=$2[@]
    local options=("${!array_name}")
    local default_idx=${3:-0}
    
    local selected=$default_idx
    local input_buffer=""

    # bash 3.2(macOS 기본)는 소수점 타임아웃을 지원하지 않음
    local esc_timeout="0.1"
    if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then esc_timeout="1"; fi

    tput civis # 커서 숨기기
    
    render() {
        echo -e "${CYAN}$prompt${NC}"
        if [ -n "$input_buffer" ]; then
            echo -e "  ${YELLOW}입력중: $input_buffer${NC}"
        fi
        
        for i in "${!options[@]}"; do
            local num=$((i+1))
            if [ "$i" -eq "$selected" ]; then
                echo -e "  ${GREEN}▶ $num. ${options[$i]}${NC}"
            else
                echo -e "    $num. ${options[$i]}"
            fi
        done
    }
    
    clear_and_render() {
        local lines=${#options[@]}
        ((lines += 1))
        if [ -n "$input_buffer" ] || [ "$1" = "had_buffer" ]; then
            ((lines += 1))
        fi
        
        tput cuu $lines
        tput ed
        
        render
    }
    
    render
    local had_buffer="false"
    
    while true; do
        read -rsn1 key
        
        if [[ $key == $'\x1b' ]]; then
            read -rsn2 -t "$esc_timeout" ext
            if [[ $ext == "[A" ]]; then # Up
                ((selected--))
                if [ $selected -lt 0 ]; then selected=$((${#options[@]} - 1)); fi
                input_buffer=""
            elif [[ $ext == "[B" ]]; then # Down
                ((selected++))
                if [ $selected -ge ${#options[@]} ]; then selected=0; fi
                input_buffer=""
            fi
        elif [[ $key == "" ]]; then # Enter
            break
        elif [[ $key == $'\x7f' || $key == $'\b' ]]; then # Backspace
            input_buffer="${input_buffer%?}"
        else
            input_buffer="${input_buffer}${key}"
            for i in "${!options[@]}"; do
                if [ "$((i+1))" = "$input_buffer" ]; then
                    selected=$i
                fi
            done
        fi
        
        clear_and_render "$had_buffer"
        if [ -n "$input_buffer" ]; then
            had_buffer="true"
        else
            had_buffer="false"
        fi
    done
    
    tput cnorm
    MENU_RESULT=$selected
    
    local lines=${#options[@]}
    ((lines += 1))
    [ "$had_buffer" = "true" ] && ((lines += 1))
    tput cuu $lines
    tput ed
    
    # 선택된 결과만 프롬프트와 함께 출력
    echo -e "${CYAN}$prompt${NC} ${GREEN}${options[$MENU_RESULT]}${NC}"
}

# 설정 파일 위치
CONFIG_FILE="$HOME/.gemini-commit-config.json"

# JSON 파일에서 특정 키의 값을 안전하게 추출하는 함수
read_json_val() {
    local file="$1"
    local key="$2"
    if [ -f "$file" ]; then
        if command -v node >/dev/null 2>&1; then
            node -e "try { const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8')); if(d['$key']!==undefined) console.log(d['$key']); } catch(e){}" "$file" 2>/dev/null
        else
            grep -E -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$file" 2>/dev/null | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/'
        fi
    fi
}

# Provider와 Model 간 호환성 검증 및 잘못된 모델 초기화
validate_provider_model() {
    if [ "$PROVIDER" = "claude" ]; then
        if [[ "$MODEL" == *"gemini"* ]]; then
            MODEL=""
        fi
    elif [ "$PROVIDER" = "agy" ]; then
        if [[ "$MODEL" == *"claude"* || "$MODEL" == "opus" || "$MODEL" == "sonnet" || "$MODEL" == "haiku" || "$MODEL" == "fable" ]]; then
            MODEL=""
        fi
    fi
}

# 설정 파일 읽기 함수
load_config() {
    # 글로벌 설정 읽기
    if [ -f "$CONFIG_FILE" ]; then
        LANGUAGE=$(read_json_val "$CONFIG_FILE" "language")
        MODEL=$(read_json_val "$CONFIG_FILE" "model")
        PROVIDER=$(read_json_val "$CONFIG_FILE" "provider")
        [ -z "$LANGUAGE" ] && LANGUAGE="ko"
    else
        LANGUAGE=""
        MODEL=""
        PROVIDER=""
    fi

    # 프로젝트(로컬) 설정 읽기
    LOCAL_CONFIG_FILE="./.aicrc"
    if [ -f "$LOCAL_CONFIG_FILE" ]; then
        LOCAL_LANG=$(read_json_val "$LOCAL_CONFIG_FILE" "language")
        LOCAL_MODEL=$(read_json_val "$LOCAL_CONFIG_FILE" "model")
        LOCAL_PROVIDER=$(read_json_val "$LOCAL_CONFIG_FILE" "provider")

        [ -n "$LOCAL_LANG" ] && LANGUAGE="$LOCAL_LANG"
        
        # 로컬에서 provider가 지정되었고 글로벌과 다른 경우 모델 상속 차단
        if [ -n "$LOCAL_PROVIDER" ]; then
            if [ "$LOCAL_PROVIDER" != "${PROVIDER:-agy}" ] && [ -z "$LOCAL_MODEL" ]; then
                MODEL=""
            fi
            PROVIDER="$LOCAL_PROVIDER"
        fi
        [ -n "$LOCAL_MODEL" ] && MODEL="$LOCAL_MODEL"
    fi

    # CLI 플래그(--provider)가 지정된 경우 설정보다 우선.
    # provider가 바뀌면 저장된 모델 ID는 호환되지 않으므로 함께 비운다.
    if [ -n "$PROVIDER_OVERRIDE" ]; then
        [ "$PROVIDER_OVERRIDE" != "${PROVIDER:-agy}" ] && MODEL=""
        PROVIDER="$PROVIDER_OVERRIDE"
    fi

    # 기본 provider (기존 사용자 호환)
    [ -z "$PROVIDER" ] && PROVIDER="agy"

    # Provider와 Model 상호 호환성 검증
    validate_provider_model
}

# 설정 파일 저장 함수
save_config() {
    local lang=$1
    mkdir -p "$(dirname "$CONFIG_FILE")"
    write_config_file "$CONFIG_FILE" "$lang" "$MODEL" "$PROVIDER"
}

# 설정 JSON 작성 (빈 값은 키 자체를 생략)
write_config_file() {
    local file=$1 lang=$2 model=$3 provider=$4
    local json='{"language":"'"$lang"'"'
    [ -n "$model" ] && json="$json"',"model":"'"$model"'"'
    [ -n "$provider" ] && json="$json"',"provider":"'"$provider"'"'
    echo "$json}" > "$file"
}

# Git 브랜치 이름에서 이슈 번호/티켓 키 추출 (예: PROJ-123, #45, issue-12)
detect_issue_key() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    [ -z "$branch" ] && return

    # 1. JIRA 스타일: 대문자 알파벳 2~10자 + 하이픈 + 숫자 (예: PROJ-123)
    local jira_key
    jira_key=$(echo "$branch" | grep -o -E '[A-Z]{2,10}-[0-9]+' | head -1)
    if [ -n "$jira_key" ]; then
        echo "$jira_key"
        return
    fi

    # 2. #숫자 스타일 (예: feature/#123-login)
    local hash_key
    hash_key=$(echo "$branch" | grep -o -E '#[0-9]+' | head -1)
    if [ -n "$hash_key" ]; then
        echo "$hash_key"
        return
    fi

    # 3. issue-숫자 or gh-숫자 (예: issue-45, gh-88)
    local issue_num
    issue_num=$(echo "$branch" | grep -o -E '(issue|gh)-[0-9]+' | head -1 | grep -o -E '[0-9]+')
    if [ -n "$issue_num" ]; then
        echo "#$issue_num"
        return
    fi
}

# provider별 CLI 인자 구성 -> AI_ARGS 배열에 채움
build_ai_args() {
    local prompt="$1"
    AI_ARGS=()
    [ -n "$MODEL" ] && AI_ARGS=("--model" "$MODEL")
    if [ "$PROVIDER" = "claude" ]; then
        # claude: -p 는 플래그, 프롬프트는 위치 인자
        AI_ARGS=("${AI_ARGS[@]}" "-p" "$prompt")
    else
        # agy: --print 가 프롬프트를 값으로 받음
        AI_ARGS=("${AI_ARGS[@]}" "--print" "$prompt")
    fi
}

# provider별 사용 가능한 모델 목록 -> models / model_displays 배열에 채움
fetch_models() {
    models=()
    model_displays=()

    if [ "$PROVIDER" = "claude" ]; then
        while IFS=$'\t' read -r id name; do
            if [ -n "$id" ]; then
                models=("${models[@]}" "$id")
                model_displays=("${model_displays[@]}" "$name ($id)")
            fi
        done <<'CLAUDE_MODELS'
opus	Opus (latest)
sonnet	Sonnet (latest)
haiku	Haiku (latest)
fable	Fable (latest)
claude-opus-5	Claude Opus 5
claude-sonnet-5	Claude Sonnet 5
claude-fable-5	Claude Fable 5
claude-haiku-4-5-20251001	Claude Haiku 4.5
CLAUDE_MODELS
    else
        while IFS=$'\t' read -r id name; do
            if [ -n "$id" ] && [[ "$id" != *"Fetching"* ]]; then
                models=("${models[@]}" "$id")
                model_displays=("${model_displays[@]}" "$name ($id)")
            fi
        done < <(agy models 2>/dev/null)
    fi
}

# 언어별 메시지 함수
msg() {
    local key=$1
    shift  # 메시지 본문에서 $1 부터가 실제 치환 값이 되도록
    case "$LANGUAGE" in
        "en")
            case "$key" in
                "welcome") echo "🤖 AI Commit CLI - AI-powered commit message generator" ;;
                "setup_progress") echo "🔧 Setting up Git alias..." ;;
