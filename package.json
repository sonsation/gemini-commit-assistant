{
  "name": "gemini-commit-assistant",
  "version": "1.0.8",
  "description": "AI-powered commit message generator using Gemini CLI",
  "bin": {
    "aic": "./dist/cli.js",
    "ai-commit": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && chmod +x dist/cli.js && chmod +x bin/postinstall.js",
    "postinstall": "node bin/postinstall.js"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "gemini",
    "cli",
    "automation",
    "developer-tools"
  ],
  "author": "C17AN",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c17an/gemini-commit-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/c17an/gemini-commit-assistant/issues"
  },
  "homepage": "https://github.com/c17an/gemini-commit-assistant#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
